generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════
// AUTH
// ══════════════════════════════════════

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ══════════════════════════════════════
// LEADS — form submissions
// ══════════════════════════════════════

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  service   String?  // which service they're interested in
  message   String?
  status    String   @default("new") // new, contacted, qualified, converted, lost
  notes     String?  // internal notes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ══════════════════════════════════════
// PROJECTS — portfolio / case studies
// ══════════════════════════════════════

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  client      String
  category    String
  description String
  approach    String?
  liveUrl     String?
  image       String?  // path like /portfolio/mitsubishi.png
  color       String   @default("#0d9488")
  featured    Boolean  @default(false)
  order       Int      @default(0)
  status      String   @default("published") // draft, published, archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation to client
  clientId    String?
  clientRef   Client?  @relation(fields: [clientId], references: [id])
}

// ══════════════════════════════════════
// SERVICES
// ══════════════════════════════════════

model Service {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String
  icon      String   // lucide icon name: Globe, Database, etc.
  order     Int      @default(0)
  status    String   @default("published")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ══════════════════════════════════════
// INSIGHTS — blog / articles
// ══════════════════════════════════════

model Insight {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  body        String   // markdown or HTML content
  topic       String   // Strategi, Sistem, Otomotif, etc.
  author      String   @default("Abu Aufa")
  thumbnail   String?
  status      String   @default("draft") // draft, published
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ══════════════════════════════════════
// TESTIMONIALS
// ══════════════════════════════════════

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  role      String?  // jabatan
  company   String
  featured  Boolean  @default(false) // main vs supporting
  order     Int      @default(0)
  status    String   @default("published")
  projectId String?  // optional link to project
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ══════════════════════════════════════
// CLIENTS
// ══════════════════════════════════════

model Client {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  website   String?
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
}

// ══════════════════════════════════════
// FAQ
// ══════════════════════════════════════

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("general")
  order     Int      @default(0)
  status    String   @default("published")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ══════════════════════════════════════
// SETTINGS — global site config
// ══════════════════════════════════════

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
