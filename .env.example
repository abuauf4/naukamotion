# ─── Nauka Motion — Environment Variables ───
# Copy this file to .env.local for local development.
# Set real values in Vercel Project Settings for production.
# NEVER commit .env or .env.local with real credentials.

# Database — Neon PostgreSQL (pooled connection for runtime)
DATABASE_URL=

# Database — Neon PostgreSQL (direct connection for Prisma migration)
DIRECT_URL=

# JWT secret for admin auth — generate a strong random value:
#   openssl rand -base64 32
JWT_SECRET=

# Admin bootstrap credentials (for scripts/bootstrap-admin.ts only)
# Password is hashed with bcrypt before storing in database
ADMIN_USERNAME=
ADMIN_PASSWORD=

# CMS data source — leave unset for database (default) or set to 'static' for emergency fallback
# CMS_DATA_SOURCE=database

# Supabase — legacy, not used by CMS V2. Leave empty.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
