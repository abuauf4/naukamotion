# Database — Neon PostgreSQL (set actual values in Vercel env or .env.local)
# This file is committed to git. NEVER put credentials here.
# Use .env.local (gitignored) for local development credentials.
DATABASE_URL="file:./db/custom.db"

# JWT secret — MUST be set to a strong random value in production.
# Do NOT use this default in production.
JWT_SECRET=change-me-in-production

# Admin credentials — for bootstrap script only (scripts/bootstrap-admin.ts)
# Password is hashed with bcrypt before storing in database.
# Do NOT use these in production — set via env vars and run bootstrap script.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Supabase — legacy, not used by CMS V2. Leave empty.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
