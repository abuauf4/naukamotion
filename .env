# Database (Prisma SQLite). Path relatif terhadap root repo.
DATABASE_URL="file:./db/custom.db"

# JWT secret untuk admin auth. WAJIB di-set di production ke nilai acak panjang.
# Jangan gunakan nilai default ini di production.
JWT_SECRET=nauka-motion-admin-secret-2026

# Admin credentials (fallback jika database tidak tersedia)
ADMIN_USERNAME=Bagas
ADMIN_PASSWORD=122333

# Supabase — opsional. Jika kosong, API /api/public/* akan return data fallback
# dari src/lib/fallback-data.ts dan /work pages akan tetap pakai studio-data.ts.
# Isi jika ingin menggunakan admin panel dengan database Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
